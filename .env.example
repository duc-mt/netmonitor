# LibreNMS Docker settings.
# Do not edit this file: run the setup script (scripts/setup.sh or scripts\setup.ps1).
# It copies this template to .env and fills in random secrets. .env is git-ignored.

TZ=UTC
PUID=1000
PGID=1000

# Database. The password is generated by the setup script.
MYSQL_DATABASE=librenms
MYSQL_USER=librenms
MYSQL_PASSWORD=

# SNMPv2c community of the LibreNMS container itself (generated).
LIBRENMS_SNMP_COMMUNITY=

# Image versions. "latest" follows upstream; pin a tag (for example 25.1.0) to freeze it.
LIBRENMS_VERSION=latest
MARIADB_VERSION=10.11
REDIS_VERSION=7.2-alpine
MSMTPD_VERSION=latest

# MariaDB tuning (README, "Tuning"). The buffer pool caches tables and indexes in RAM: 512M is a
# sensible start, raise it on a big installation and lower it on a small VM. MAX_CONNECTIONS must
# cover the web UI plus every dispatcher worker.
MARIADB_BUFFER_POOL_SIZE=512M
MARIADB_MAX_CONNECTIONS=250

# Poller settings: how many devices the dispatcher polls in parallel.
DISPATCHER_WORKERS=8

# Address people open LibreNMS at, for the links in Telegram messages (doctor --notify and Oxidized), for example
# https://nms.example.com. Empty: the proxy name if there is a public one, else http://<this host>:LIBRENMS_PORT.
NOTIFY_BASE_URL=

# Off-site copy of every backup (./run backup): an rclone destination such as s3:my-bucket/netmonitor, empty = off.
# Needs rclone on this computer and a remote set up with "rclone config". ./run backup --no-offsite skips it once.
BACKUP_REMOTE=

# Data retention, applied by "./run configure": how many days LibreNMS keeps syslog messages and event log
# entries before its daily cleanup deletes them. Fewer days keep the database smaller.
SYSLOG_PURGE_DAYS=30
EVENTLOG_PURGE_DAYS=90
# More retention, all optional (empty: LibreNMS keeps its own default). "./run configure" applies them too.
# AUTHLOG_PURGE_DAYS: login history (LibreNMS default 30). ALERTLOG_PURGE_DAYS: alert history (default 365).
# RRD_PURGE_DAYS: DELETES the graph files of devices that have not been updated for this many days (default 0: never).
AUTHLOG_PURGE_DAYS=
ALERTLOG_PURGE_DAYS=
RRD_PURGE_DAYS=

# Initial admin account, created by "./run configure" when both are set (nothing happens if the user exists).
# Put the value in single quotes if the password contains $ or #. Remove the password from .env afterwards if you
# like: LibreNMS keeps only a hash. Another account later: ./run user-add <name> (generates a password).
LIBRENMS_ADMIN_USER=
LIBRENMS_ADMIN_PASSWORD=

# "./run doctor" warnings for the storage check: a disk fuller than this many percent, or a data/db/nfsen volume
# larger than this many GB. Optional; the numbers below are the defaults.
# DOCTOR_DISK_WARN_PCT=80
# DOCTOR_VOLUME_WARN_GB=50

# Network. The web UI listens on localhost only by default.
# Set LIBRENMS_BIND=0.0.0.0 to reach it from other machines (put TLS in front of it).
LIBRENMS_BIND=127.0.0.1
LIBRENMS_PORT=8000
# SYSLOG_PORT and TRAP_PORT also take an address, e.g. SYSLOG_PORT=192.0.2.10:514 (README, Firewall).
SYSLOG_PORT=514
TRAP_PORT=162

# ntopng Community (profile "ntopng", Linux hosts only, see README).
# NTOPNG_INTERFACE: the host interface to capture on, ideally a mirror/SPAN port (ip -br link).
# The web UI listens on localhost only by default, like LibreNMS. ntopng asks you to change
# its default login (admin/admin) on the first visit.
NTOPNG_VERSION=latest
NTOPNG_INTERFACE=eth0
NTOPNG_BIND=127.0.0.1
NTOPNG_WEB_PORT=3000
NTOPNG_REDIS_PORT=6380

# Outbound mail relay (profile "mail", README "Email alerts"). Fill these in BEFORE enabling the profile.
# Port 587 normally means SMTP_STARTTLS=on; port 465 means SMTP_TLS=on with SMTP_STARTTLS=off.
# Put the value in single quotes if the password contains $ or #.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=on
SMTP_STARTTLS=on

# NetFlow / sFlow collector with NfSen (profile "netflow", README "NetFlow / sFlow (NfSen)").
# NFSEN_SOURCES: one source per exporting device, separated by ":", each written name,port,colour,type[,options]
#   name: up to 19 letters, digits or underscores. It must match the device name in LibreNMS (see README).
#   port: a UDP port inside the published range below. One port per device.
#   type: netflow or sflow. options: only if the device samples, for example -s -1000.
# Keep the single quotes: the value contains # and may contain spaces.
NFSEN_SOURCES='router1,2055,#0000ff,netflow'
NFSEN_FLOW_PORT_FIRST=2055
NFSEN_FLOW_PORT_LAST=2064
# The NfSen web UI has no login: it listens on localhost only unless you change NFSEN_BIND.
NFSEN_BIND=127.0.0.1
NFSEN_WEB_PORT=8080
# Community image, pin a tag or build your own (README). latest follows the maintainer.
NFSEN_IMAGE=rguaitanele/docker-nfsen
NFSEN_VERSION=latest

# Telegram notifications (applied via ./run configure).
# Create a bot with @BotFather, get CHAT_ID from @userinfobot or group @RawDataBot.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Grafana (profile "grafana", README "Grafana"). Localhost only by default, port 3001 because ntopng uses 3000. CHANGE the admin password
# before binding it to another address. The LibreNMS database datasource is provisioned automatically.
GRAFANA_VERSION=11.2.0
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Oxidized (profile "oxidized", README "Oxidized"): continuous backups, visual diffs in LibreNMS "Config" tab.
# OXIDIZED_LIBRENMS_TOKEN: a LibreNMS API token; "./run oxidized-setup" creates it and fills this in (or: web UI, user menu > API Settings).
# OXIDIZED_USERNAME / OXIDIZED_PASSWORD: the login Oxidized uses on your devices. Its web UI has no login.
OXIDIZED_VERSION=latest
OXIDIZED_BIND=127.0.0.1
OXIDIZED_PORT=8888
OXIDIZED_LIBRENMS_TOKEN=
OXIDIZED_USERNAME=
OXIDIZED_PASSWORD=
# Optional, applied when Oxidized starts (./run restart oxidized). OXIDIZED_NOTIFY_TELEGRAM=true sends a Telegram
# message (TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID below) whenever a device's configuration changed.
# OXIDIZED_GIT_REMOTE pushes the configuration repository to your own git server after every change, for example
# https://user:TOKEN@git.example.com/network/configs.git (the token is in .env, keep it 600).
OXIDIZED_NOTIFY_TELEGRAM=false
# OXIDIZED_NOTIFY_DIFF=true adds the changed lines (up to 20) to that message. A configuration holds secrets and
# Telegram is a third party: lines that look like secrets are hidden, but that is a filter, so leave this off unless
# you accept the risk.
OXIDIZED_NOTIFY_DIFF=false
OXIDIZED_GIT_REMOTE=

# Smokeping (profile "smokeping", README "Smokeping"). Its web UI has no login.
SMOKEPING_VERSION=latest
SMOKEPING_BIND=127.0.0.1
SMOKEPING_PORT=8085

# Caddy HTTPS proxy (profile "proxy", README "HTTPS (reverse proxy)"). *.localhost names use Caddy's own CA;
# use real names with public DNS for Let's Encrypt certificates.
CADDY_VERSION=2-alpine
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
CADDY_LIBRENMS_HOST=nms.localhost
CADDY_GRAFANA_HOST=grafana.localhost
CADDY_OXIDIZED_HOST=oxidized.localhost
CADDY_SMOKEPING_HOST=smokeping.localhost
# Optional HTTP Basic Auth for the Oxidized and Smokeping names, on top of the private-network rule. Off while the
# user is empty. The hash is made with:  docker run --rm caddy:2-alpine caddy hash-password
# and MUST be in single quotes, because it contains $ characters:  OXIDIZED_AUTH_HASH='$2a$14$...'
OXIDIZED_AUTH_USER=
OXIDIZED_AUTH_HASH=
SMOKEPING_AUTH_USER=
SMOKEPING_AUTH_HASH=

# Optional services, comma separated: syslog,traps,ntopng,mail,netflow,grafana,oxidized,smokeping,proxy
COMPOSE_PROFILES=
