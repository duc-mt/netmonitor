# LibreNMS Docker settings.
# Do not edit this file: run the setup script (scripts/setup.sh or scripts\setup.ps1).
# It copies this template to .env and fills in random secrets. .env is git-ignored.

TZ=UTC
PUID=1000
PGID=1000

# Database. The password is generated by the setup script.
MYSQL_DATABASE=librenms
MYSQL_USER=librenms
MYSQL_PASSWORD=

# SNMPv2c community of the LibreNMS container itself (generated).
LIBRENMS_SNMP_COMMUNITY=

# Image versions. "latest" follows upstream; pin a tag (for example 25.1.0) to freeze it.
LIBRENMS_VERSION=latest
MARIADB_VERSION=10.11
REDIS_VERSION=7.2-alpine
MSMTPD_VERSION=latest

# MariaDB tuning (README, "Tuning"). The buffer pool caches tables and indexes in RAM: 512M is a
# sensible start, raise it on a big installation and lower it on a small VM. MAX_CONNECTIONS must
# cover the web UI plus every dispatcher worker.
MARIADB_BUFFER_POOL_SIZE=512M
MARIADB_MAX_CONNECTIONS=250

# Poller settings: how many devices the dispatcher polls in parallel.
DISPATCHER_WORKERS=8

# Network. The web UI listens on localhost only by default.
# Set LIBRENMS_BIND=0.0.0.0 to reach it from other machines (put TLS in front of it).
LIBRENMS_BIND=127.0.0.1
LIBRENMS_PORT=8000
# SYSLOG_PORT and TRAP_PORT also take an address, e.g. SYSLOG_PORT=192.0.2.10:514 (README, Firewall).
SYSLOG_PORT=514
TRAP_PORT=162

# ntopng Community (profile "ntopng", Linux hosts only, see README).
# NTOPNG_INTERFACE: the host interface to capture on, ideally a mirror/SPAN port (ip -br link).
# The web UI listens on localhost only by default, like LibreNMS. ntopng asks you to change
# its default login (admin/admin) on the first visit.
NTOPNG_VERSION=stable
NTOPNG_INTERFACE=eth0
NTOPNG_BIND=127.0.0.1
NTOPNG_WEB_PORT=3000
NTOPNG_REDIS_PORT=6380

# Outbound mail relay (profile "mail", README "Email alerts"). Fill these in BEFORE enabling the profile.
# Port 587 normally means SMTP_STARTTLS=on; port 465 means SMTP_TLS=on with SMTP_STARTTLS=off.
# Put the value in single quotes if the password contains $ or #.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=on
SMTP_STARTTLS=on

# NetFlow / sFlow collector with NfSen (profile "netflow", README "NetFlow / sFlow (NfSen)").
# NFSEN_SOURCES: one source per exporting device, separated by ":", each written name,port,colour,type[,options]
#   name: up to 19 letters, digits or underscores. It must match the device name in LibreNMS (see README).
#   port: a UDP port inside the published range below. One port per device.
#   type: netflow or sflow. options: only if the device samples, for example -s -1000.
# Keep the single quotes: the value contains # and may contain spaces.
NFSEN_SOURCES='router1,2055,#0000ff,netflow'
NFSEN_FLOW_PORT_FIRST=2055
NFSEN_FLOW_PORT_LAST=2064
# The NfSen web UI has no login: it listens on localhost only unless you change NFSEN_BIND.
NFSEN_BIND=127.0.0.1
NFSEN_WEB_PORT=8080
# Community image, pin a tag or build your own (README). latest follows the maintainer.
NFSEN_IMAGE=rguaitanele/docker-nfsen
NFSEN_VERSION=latest

# Telegram notifications (applied via ./run configure).
# Create a bot with @BotFather, get CHAT_ID from @userinfobot or group @RawDataBot.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional services, comma separated: syslog,traps,ntopng,mail,netflow
COMPOSE_PROFILES=
