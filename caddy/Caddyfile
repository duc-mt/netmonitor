# Reverse proxy for the optional "proxy" profile. One host name per service, set in .env.
# *.localhost names get a certificate from Caddy's own CA (browser warning until you trust it).
# For real names with public DNS, Caddy fetches Let's Encrypt certificates by itself.
# Services whose profile is off simply answer 502 on their name.

{$CADDY_LIBRENMS_HOST:nms.localhost} {
	reverse_proxy librenms:8000
}

{$CADDY_GRAFANA_HOST:grafana.localhost} {
	reverse_proxy grafana:3000
}

# Oxidized and Smokeping have no login of their own: private (LAN) source addresses only.
{$CADDY_OXIDIZED_HOST:oxidized.localhost} {
	@outside not remote_ip private_ranges 127.0.0.1/8 ::1
	respond @outside 403
	reverse_proxy oxidized:8888
}

{$CADDY_SMOKEPING_HOST:smokeping.localhost} {
	@outside not remote_ip private_ranges 127.0.0.1/8 ::1
	respond @outside 403
	reverse_proxy smokeping:80
}
