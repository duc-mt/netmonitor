#!/bin/sh
# Fake docker for the tests: records every call in $FAKE_LOG and answers the few questions the scripts ask.
#   FAKE_INFO_EXIT    exit code of "docker info" (default 0)
#   FAKE_RUNNING      what "docker compose ps --status running --services" lists (default: all four default services;
#                     an empty value means nothing is running)
#   FAKE_CONFIG_GET   what "lnms config:get ..." prints
#   FAKE_UP_EXIT      exit code of "docker compose up -d --wait" (default 0)
#   FAKE_FAIL_MATCH   any call containing this text fails with exit code 1
#   FAKE_MEMTOTAL     what "docker info --format {{.MemTotal}}" prints, in bytes (default 8 GiB)
#   FAKE_SERVICES     what "docker compose config --services" lists (default: db redis librenms dispatcher)
echo "$*" >> "${FAKE_LOG:?FAKE_LOG must be set}"
case "$*" in
  *"${FAKE_FAIL_MATCH:-@@never@@}"*) exit 1 ;;
  info) exit "${FAKE_INFO_EXIT:-0}" ;;
  "info --format "*) echo "${FAKE_MEMTOTAL:-8589934592}" ;;
  "compose version") echo "Docker Compose version v2.fake" ;;
  "compose config --services") echo "${FAKE_SERVICES:-db redis librenms dispatcher}" | tr ' ' '\n' ;;
  "compose ps --status running --services") echo "${FAKE_RUNNING-db redis librenms dispatcher}" | tr ' ' '\n' ;;
  "compose images") echo "CONTAINER REPOSITORY TAG" ;;
  *config:get*) printf '%s\n' "${FAKE_CONFIG_GET:-}" ;;
  "compose up -d --wait") exit "${FAKE_UP_EXIT:-0}" ;;
esac
exit 0
